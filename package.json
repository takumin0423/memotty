{
  "name": "memotty",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @memotty/web dev",
    "build": "pnpm --filter @memotty/web build",
    "test": "pnpm -r --if-present test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm -r --if-present lint",
    "lint:check": "pnpm -r --if-present lint:check",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm format:check && pnpm lint:check && pnpm typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0"
  },
  "packageManager": "pnpm@12.21.0"
}
